//Process accessing Browser (Chrome/Edge/Firefox credential store files (PureLog Stealer)
DeviceFileEvents
| where Timestamp > ago(30d)
| where FolderPath has_any (
    @"\Google\Chrome\User Data\",
    @"\Microsoft\Edge\User Data\",
    @"\Mozilla\Firefox\Profiles\"
)
| where FileName in~ ("Login Data", "key4.db", "logins.json", "cookies.sqlite")
| where ActionType in ("FileModified", "FileRenamed", "FileCreated") or ActionType has "Read"
| extend BrowserVendor = case(
    FolderPath has "Chrome", "Chrome",
    FolderPath has "Edge", "Edge",
    FolderPath has "Firefox", "Firefox",
    "Unknown"
)
| project Timestamp, DeviceName, InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessParentFileName, FolderPath, FileName, BrowserVendor, ActionType
| where InitiatingProcessFileName in~ ("powershell.exe", "regsvcs.exe", "InstallUtil.exe", "csc.exe", "vbc.exe", "msbuild.exe", "ilasm.exe", "caspol.exe", "aspnet_compiler.exe")
