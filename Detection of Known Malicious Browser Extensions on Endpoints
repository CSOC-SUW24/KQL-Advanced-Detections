| where Timestamp > ago(30d)
| where FolderPath has_any (MaliciousExtensionIds)
| extend FolderPathLower = tolower(FolderPath)
| mv-apply ExtensionId = MaliciousExtensionIds to typeof(string) on (
    where FolderPathLower has ExtensionId
)
| where FolderPathLower has @"\extensions\"
    or FolderPathLower has @"/extensions/"
    or FolderPathLower has @"\extension state\"
    or FolderPathLower has @"\local extension settings\"
| project
    Timestamp,
    DeviceName,
    ActionType,
    MatchedExtensionId = ExtensionId,
    FileName,
    FolderPath,
    SHA256,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    InitiatingProcessAccountName
| order by Timestamp desc
