//VPN Failed Auth Followed by Successful Auth (FortiGate/FortiNet)
//Replace "CommonSecurityLog" with your table.
CommonSecurityLog
| where TimeGenerated >= ago(30d)
| where DeviceVendor has_any ("Fortinet", "Fortigate")
    or DeviceProduct has_any ("FortiGate", "Fortinet")
| where DeviceEventClassID == "0101039424"
    or Activity has "tunnel up"
    or Message has "tunnel up"
    or AdditionalExtensions has "0101039424"
| extend User = tolower(coalesce(
        tostring(DestinationUserName),
        tostring(SourceUserName),
        extract(@"user=""?([^""\s;]+)", 1, tostring(Message)),
        extract(@"user=([^;\s]+)", 1, tostring(AdditionalExtensions))
))
| where isnotempty(User)
| project
    SuccessTime = TimeGenerated,
    User,
    SuccessSourceIP = tostring(column_ifexists("SourceIP", "")),
    SuccessDestinationIP = tostring(column_ifexists("DestinationIP", "")),
    SuccessDevice = DeviceName,
    SuccessEventId = DeviceEventClassID,
    SuccessActivity = Activity,
    SuccessMessage = Message
| join kind=inner (
    CommonSecurityLog
    | where TimeGenerated >= ago(30d)
    | where DeviceVendor has_any ("Fortinet", "Fortigate")
        or DeviceProduct has_any ("FortiGate", "Fortinet")
    | where DeviceEventClassID == "0101039426"
        or Activity has "sslvpn_login_permission_denied"
        or Message has "sslvpn_login_permission_denied"
        or AdditionalExtensions has "sslvpn_login_permission_denied"
    | extend User = tolower(coalesce(
            tostring(DestinationUserName),
            tostring(SourceUserName),
            extract(@"user=""?([^""\s;]+)", 1, tostring(Message)),
            extract(@"user=([^;\s]+)", 1, tostring(AdditionalExtensions))
    ))
    | where isnotempty(User)
    | project
        FailTime = TimeGenerated,
        User,
        FailSourceIP = tostring(column_ifexists("SourceIP", "")),
        FailDestinationIP = tostring(column_ifexists("DestinationIP", "")),
        FailDevice = DeviceName,
        FailEventId = DeviceEventClassID,
        FailActivity = Activity,
        FailMessage = Message
) on User
| where FailTime between (SuccessTime - 2m .. SuccessTime)
| summarize
    FailedAttempts = count(),
    FirstFailure = min(FailTime),
    LastFailure = max(FailTime),
    FailedSourceIPs = make_set(FailSourceIP, 20),
    FailureMessages = make_set(FailMessage, 10)
by
    User,
    SuccessTime,
    SuccessSourceIP,
    SuccessDestinationIP,
    SuccessDevice,
    SuccessEventId,
    SuccessActivity,
    SuccessMessage
| where FailedAttempts >= 5
| project
    SuccessTime,
    User,
    FailedAttempts,
    FirstFailure,
    LastFailure,
    SuccessSourceIP,
    FailedSourceIPs,
    SuccessDestinationIP,
    SuccessDevice,
    SuccessEventId,
    SuccessActivity,
    SuccessMessage,
    FailureMessages
| order by SuccessTime desc
