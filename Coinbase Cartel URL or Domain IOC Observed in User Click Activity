UrlClickEvents
| where Timestamp > ago(Lookback)
| extend ClickedUrl = trim(" \r\n\t", tolower(Url))
| extend ClickedDomain = tolower(tostring(parse_url(ClickedUrl).Host))
| extend ClickedDomain = replace_regex(ClickedDomain, @"^www\.", "")
| where ClickedUrl in (CoinbaseCartelUrls)
    or ClickedDomain in (CoinbaseCartelDomains)
| extend MatchType = case(
    ClickedUrl in (CoinbaseCartelUrls), "Exact URL match",
    ClickedDomain in (CoinbaseCartelDomains), "Domain match",
    "Unknown"
)
| project
    Timestamp,
    AccountUpn,
    IPAddress,
    Workload,
    ActionType,
    IsClickedThrough,
    MatchType,
    ClickedUrl,
    ClickedDomain,
    ThreatTypes,
    DetectionMethods,
    NetworkMessageId,
    ReportId
| order by Timestamp desc
