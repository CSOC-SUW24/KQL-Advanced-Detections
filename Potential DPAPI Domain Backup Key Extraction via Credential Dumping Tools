//Potential DPAPI Domain Backup Key Extraction via Credential Dumping Tools
DeviceProcessEvents
| where Timestamp >= ago(30d)
| extend Cmd = tolower(tostring(ProcessCommandLine))
| extend Proc = tolower(tostring(FileName))
| where Cmd has_any (
    "lsadump::backupkeys",
    "dpapi::backupkeys",
    "sharpdpapi backupkeys",
    "backupkey /server",
    "backupkeys /server",
    "backupkey /target",
    "backupkeys /target",
    "/pvk",
    ".pvk"
)
or (
    Cmd has "mimikatz"
    and Cmd has_any ("backupkeys", "lsadump", "dpapi")
)
or (
    Cmd has "sharpdpapi"
    and Cmd has_any ("backupkeys", "backupkey", "pvk")
)
| project
    Timestamp,
    DeviceName,
    AccountName,
    FileName,
    ProcessCommandLine,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    FolderPath,
    SHA1,
    SHA256,
    DeviceId,
    ReportId
| order by Timestamp desc
